+        /// <summary>
+        ///     uo-offline 0006: where a static's art is drawn relative to its tile (x: half width - 22, y: height - 44),
+        ///     from the loaded sprite itself. Art that exists only as an ExternalImages PNG has no art.mul entry, so
+        ///     GetValidRefEntry hands back the one shared UOFileIndex.Invalid, whose Width/Height every such sprite
+        ///     overwrites while drawing: the hit test then used another item's offsets and missed small items.
+        /// </summary>
+        public Point GetDrawOffset(uint graphic)
+        {
+            ref readonly SpriteInfo info = ref GetArt(graphic);
+            return info.Texture == null ? Point.Zero : new Point((info.UV.Width >> 1) - 22, info.UV.Height - 44);
+        }
     }
