+        private const string IMAGES_FOLDER = "ExternalImages", GUMP_EXTERNAL_FOLDER = "gumps", ART_EXTERNAL_FOLDER = "art", LAND_EXTERNAL_FOLDER = "land";
 
         private string exePath;
         private string _uoDirectory;
@@ -317,6 +317,46 @@ namespace ClassicUO.Assets
             {
                 Directory.CreateDirectory(artPath);
             }
+
+            // Land tiles share the art index below 0x4000, so land/0x0003.png is art entry 3 (the art folder adds 0x4000).
+            string landPath = Path.Combine(exePath, IMAGES_FOLDER, LAND_EXTERNAL_FOLDER);
+
+            if (Directory.Exists(landPath))
+            {
+                foreach (string file in FindImageFiles(landPath))
+                {
+                    if (TryParseId(Path.GetFileNameWithoutExtension(file), out uint tile) && tile < 0x4000)
+                        art_availableFilePaths[tile] = file;
+                }
+            }
+
+            // An HD art pack (art/, gumps/, land/) in an HDArt folder beside the client folder: it stays put when a
+            // launcher replaces the client folder on an update. Anything in ExternalImages wins over it.
+            string pack = Path.GetFullPath(Path.Combine(exePath, "..", "HDArt"));
+
+            if (Directory.Exists(pack))
+            {
+                foreach (string folder in new[] { GUMP_EXTERNAL_FOLDER, ART_EXTERNAL_FOLDER, LAND_EXTERNAL_FOLDER })
+                {
+                    string dir = Path.Combine(pack, folder);
+
+                    if (!Directory.Exists(dir))
+                        continue;
+
+                    foreach (string file in FindImageFiles(dir))
+                    {
+                        if (!TryParseId(Path.GetFileNameWithoutExtension(file), out uint id))
+                            continue;
+
+                        if (folder == GUMP_EXTERNAL_FOLDER)
+                            gump_availableFilePaths.TryAdd(id, file);
+                        else if (folder == ART_EXTERNAL_FOLDER)
+                            art_availableFilePaths.TryAdd(id + 0x4000, file);
+                        else if (id < 0x4000)
+                            art_availableFilePaths.TryAdd(id, file);
+                    }
+                }
+            }
         }
 
         public void LoadResourceAssets(GumpsLoader gumps)
