@@ -9,6 +9,20 @@ namespace ClassicUO.Renderer
         public Rectangle UV;
         public Point Center;
 
+        /// <summary>
+        ///     <see cref="UV"/> in the texture's own pixels: the same as UV, except on an HD atlas page
+        ///     (<see cref="ScaledTexture2D"/>), where UV stays in the art's original pixels. For code that reads the
+        ///     page's pixels or hands the region to another renderer (Myra); batcher draws take UV.
+        /// </summary>
+        public Rectangle PixelUV
+        {
+            get
+            {
+                int s = Texture == null ? 1 : ScaledTexture2D.ScaleOf(Texture);
+                return s == 1 ? UV : new Rectangle(UV.X * s, UV.Y * s, UV.Width * s, UV.Height * s);
+            }
+        }
+
         public static readonly SpriteInfo Empty = new SpriteInfo { Texture = null };
     }
 }
