+        // Enter from the game (GameScene, the keyboard resting on system chat):
+        // focus the Say box when this window is open and can take text.
+        // System chat that the player opened and is typing in keeps the Enter.
+        internal static bool TakeEnter()
+        {
+            if (Keyboard.Shift)
+            {
+                return false; // Shift+Enter keeps stock behaviour (shift-enter support)
+            }
+            var gump = UIManager.GetGump<WorldChatGump>();
+            if (gump == null || gump.IsDisposed || !gump.IsVisible || !gump._input.IsVisible || !gump._input.IsEditable)
+            {
+                return false;
+            }
+            var chat = UIManager.SystemChat;
+            if (UIManager.KeyboardFocusControl != null && (chat == null || UIManager.KeyboardFocusControl != chat.TextBoxControl))
+            {
+                return false; // another text box (or the Say box itself) has the keyboard
+            }
+            if (chat != null && UIManager.KeyboardFocusControl == chat.TextBoxControl)
+            {
+                if (!string.IsNullOrEmpty(chat.TextBoxControl.Text))
+                {
+                    return false;
+                }
+                if (ProfileManager.CurrentProfile.ActivateChatAfterEnter && chat.IsActive)
+                {
+                    return false; // stock closes the open system chat line
+                }
+            }
+            gump._input.SetKeyboardFocus();
+            return true;
+        }
+
+        private static bool _releasedOnReturn;
+
+        // Read and clear the "this Enter just left the Say box" flag (GameScene, every Enter).
+        internal static bool ConsumeReleasedOnReturn()
+        {
+            bool released = _releasedOnReturn;
+            _releasedOnReturn = false;
+            return released;
+        }
+
+        // Esc while the Say box has the keyboard: hand it back to system chat.
+        internal static bool ReleaseInputFocus()
+        {
+            var gump = UIManager.GetGump<WorldChatGump>();
+            if (gump == null || UIManager.KeyboardFocusControl != gump._input)
+            {
+                return false;
+            }
+            UIManager.RestoreSystemChatFocus();
+            return true;
+        }
