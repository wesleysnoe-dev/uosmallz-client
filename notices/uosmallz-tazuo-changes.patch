diff --git a/src/ClassicUO.Renderer/ScaledTexture2D.cs b/src/ClassicUO.Renderer/ScaledTexture2D.cs
new file mode 100644
index 0000000..8b7f24a
--- /dev/null
+++ b/src/ClassicUO.Renderer/ScaledTexture2D.cs
@@ -0,0 +1,29 @@
+using Microsoft.Xna.Framework.Graphics;
+
+namespace ClassicUO.Renderer
+{
+    /// <summary>
+    ///     An atlas page holding art at <see cref="Scale"/> times its original size (an HD replacement from
+    ///     ExternalImages, exactly 2x, 3x or 4x the MUL art). Sprites on it keep their UV in original pixels, and
+    ///     the batcher divides by <see cref="LogicalWidth"/> / <see cref="LogicalHeight"/>, so every draw call
+    ///     places the art at its own size and samples the HD pixels: layout, hit testing and positions are
+    ///     unchanged. Code reading the page's pixels directly uses <see cref="SpriteInfo.PixelUV"/>.
+    /// </summary>
+    public sealed class ScaledTexture2D : Texture2D
+    {
+        public readonly int Scale;
+
+        public ScaledTexture2D(GraphicsDevice device, int width, int height, SurfaceFormat format, int scale)
+            : base(device, width, height, false, format)
+        {
+            Scale = scale;
+        }
+
+        public int LogicalWidth => Width / Scale;
+        public int LogicalHeight => Height / Scale;
+
+        public static int LogicalWidthOf(Texture2D texture) => texture is ScaledTexture2D s ? s.LogicalWidth : texture.Width;
+        public static int LogicalHeightOf(Texture2D texture) => texture is ScaledTexture2D s ? s.LogicalHeight : texture.Height;
+        public static int ScaleOf(Texture2D texture) => texture is ScaledTexture2D s ? s.Scale : 1;
+    }
+}
